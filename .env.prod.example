# Прод-окружение FPL Copilot (docker-compose.prod.yml). На сервере:
#   cp .env.prod.example .env && nano .env && chmod 600 .env
# Файл .env в git не попадает (.gitignore). Реальных секретов здесь нет — только заглушки.
# «KEY=» (пусто) = значение по умолчанию из src/fplcopilot/config.py.

# ---------- Адрес и HTTPS (Caddy) ----------
# Домен, который указывает на IP сервера (A-запись), например fpl.example.com.
# Нет домена — используйте <ip-сервера-через-точки>.sslip.io, например 203.0.113.10.sslip.io:
# это бесплатный DNS, Caddy сам получит для него сертификат Let's Encrypt.
DOMAIN=203.0.113.10.sslip.io

# ---------- Вход в приложение ----------
# Пароль для вас и проверяющих (обязательно в проде). Сгенерировать: openssl rand -base64 18
APP_PASSWORD=замените-на-длинный-пароль
# Суточный лимит запросов к ИИ из интерфейса на сервер (чат, скриншот, обновление новостей,
# объяснение сравнения). Пусто — без лимита. Жёсткий потолок трат ставьте ещё и в кабинете OpenAI.
APP_DAILY_LLM_LIMIT=200
# В проде ID менеджера не предзаполняется: каждый вводит свой (запоминается cookie в браузере).
APP_DEFAULT_MANAGER_ID=

# ---------- База данных (Postgres + pgvector, только внутри сервера) ----------
POSTGRES_USER=fpl
# Сильный пароль БД. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=замените-на-openssl-rand-hex-24
POSTGRES_DB=fpl
# DATABASE_URL задавать не нужно: docker-compose.prod.yml собирает его из POSTGRES_* сам.

# ---------- Ключи API ----------
# OpenAI: чат-агент, разбор новостей, эмбеддинги, скриншоты. Обязательно.
OPENAI_API_KEY=sk-...
# The Odds API (https://the-odds-api.com, бесплатно 500 запросов/мес): сила соперников по
# коэффициентам для ближайших 1–2 туров; без ключа модель сама падает на team_rating.
XPTS_FIXTURE_PROVIDER=odds
ODDS_API_KEY=
# LangSmith (трейсы агента) — по желанию; пусто = выключено.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fpl-copilot

# ---------- Прочее ----------
# Часовой пояс для дат дедлайнов на экране (иначе UTC).
TZ=Asia/Almaty
# ID менеджера по умолчанию только для CLI-скриптов (в интерфейс не подставляется).
FPL_MANAGER_ID=
