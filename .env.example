# Обязателен только OPENAI_API_KEY; остальные ключи можно оставить пустыми: «KEY=» = значение по
# умолчанию из config.py (для необязательных полей — «не задано»).

# --- LLM providers (OpenAI нужен для эмбеддингов, извлечения сигналов, чата и скриншотов) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Tracing (LangSmith): решает ТОЛЬКО непустой LANGSMITH_API_KEY; LANGSMITH_TRACING сам по себе ничего
# не включает (код выставляет его из ключа) и оставлен для совместимости с SDK ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fpl-copilot

# --- RAG (fplcopilot.rag.index / retrieve / extract), необязательно ---
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_DIMS=1536            # = vector(N) в 003_news_chunks.sql
# RAG_CHUNK_TOKENS=300
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_HALF_LIFE_DAYS=7               # time-decay при слиянии dense+bm25
# RAG_CANDIDATES=30                  # top-N кандидатов до reranker
# RAG_RERANKER=flashrank             # flashrank | none
# RAG_RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
# RAG v2+ (docs/rag.md, docs/EVALS.md A/B #2–#4)
# RAG_PROMPT_VERSION=v3              # v1 | v2 | v3 | v4 — промпт извлечения сигнала; дефолт v3 (A/B #3);
#                                    #   v4 = v3 + form_notes (форма/роль в карточке) — опция, не дефолт (A/B #4)
# RAG_SUMMARY_CHECK=true             # проверка summary кодом: даты/числа/имена только из цитат (v2+)
# RAG_ABSTAIN=true                   # pre-LLM abstention для игроков без новостей (триггер «нет упоминаний»)
# RAG_ABSTAIN_SCORE=0                # hybrid_rerank: порог max rerank_score (0 = выкл.; 0.2 давал ложные отказы)
# RAG_ABSTAIN_DENSE_SCORE=0          # dense: порог косинуса (0 = выкл.; косинус классы не разделяет)
# RAG_PER_ARTICLE_CAP=2              # retrieval v2: макс. чанков одной статьи в top-k (пусто = без cap)
# RAG_DATE_AWARE_RERANK=true         # retrieval v2: rerank_score × date-multiplier

# --- xPts (fplcopilot.core), необязательно ---
# Источник силы фикстур: team_rating (рейтинги FPL + xG сезона, без ключей) | odds (The Odds API v4,
# рынок h2h soccer_epl для 1–2 ближайших туров, остальные туры — team_rating; без ключа/сети/кэша
# провайдер сам падает на team_rating с одним warning). Сравнение — docs/xpts.md.
XPTS_FIXTURE_PROVIDER=team_rating
# Ключ The Odds API (https://the-odds-api.com), бесплатный тариф — 500 запросов/мес. Коэффициенты
# используются только внутри модели, пользователю никогда не показываются (наружу — FSI 1–5, xG,
# p(clean sheet) и метка источника). Пустой ключ = team_rating.
ODDS_API_KEY=
# ODDS_CACHE_TTL=21600               # сек, кэш .cache/odds/epl_h2h.json (6 ч ≈ 120 запросов/мес)
# Слабый слой внешней статы (FPL-стандарты + Understat EPL 2026/27, без ключа). Не секрет.
# XPTS_SETPIECE_WEIGHT=0.12          # +xPts за тур пенальтисту order=1 (× минуты/90)
# XPTS_FREEKICK_WEIGHT=0.03          # +xPts штатнику прямых штрафных order=1
# XPTS_UNDERSTAT_BLEND=0.25          # 25 % Understat xG90/xA90 + 75 % наши; сдвиг ≤ ±15 %
# XPTS_UNDERSTAT_SHIFT_CAP=0.15
# XPTS_SAVES_WEIGHT=0                # сейвы уже в компоненте GKP; 0 = не двоить
# UNDERSTAT_ENABLED=true
# UNDERSTAT_SEASON=2026
# UNDERSTAT_CACHE_TTL=43200          # сек, кэш .cache/understat/epl_2026.json (12 ч)
# Почему: раскладка очков за последние туры vs моменты. В xPts НЕ входит.
# WHY_FORM_LAST_N=3
# WHY_LUCK_OVER=5                    # голы+ассисты минус моменты ≥ +5 → «на удаче»
# WHY_LUCK_UNDER=-4                  # ≤ −4 → «не повезло»
# WHY_REPEATABLE_SHARE=0.50          # доля сухих / защиты / сейвов (не выход)
# WHY_REPEATABLE_MIN_POINTS=8
# WHY_PEN_XG=0.76                    # один пенальти Understat ≈ 0.76 xG
# WHY_PEN_SHRINK_K=10                # сжатие rate к среднему лиги
# WHY_PEN_LEAGUE_AVG_FALLBACK=0.14   # если матчей мало
# WHY_PEN_STANDOUT_CONCEDED=2
# WHY_PEN_MIN_P=0.30               # писать про пенальти только если P≥порога или соперник выделяется
# WHY_OPP_RATIO=1.3                # соперник vs среднее: ≥1.3× дырявый, ≤1/1.3 глухой
# WHY_OPP_MIN_MATCHES=5            # меньше матчей — молчим
# WHY_LLM_TIMEOUT_S=8
# WHY_LLM_MODEL=gpt-4o

# --- Оптимизатор (fplcopilot.core.optimizer), необязательно ---
# OPTIMIZER_SOLVER=auto              # auto | highs | cbc (cbc из PuLP не работает на macOS arm64)
# OPTIMIZER_TIME_LIMIT_S=90          # лимит на один solve, сек
# OPTIMIZER_POOL_SIZE=120            # кандидатов вне состава в многотуровом плане
# OPTIMIZER_MIP_GAP=0.001            # относительный MIP gap

# --- Агент (fplcopilot.agent, docs/agent.md), необязательно ---
# AGENT_ROUTER_MODEL=gpt-4o-mini     # роутер + грейдер сигналов (structured output, T=0)
# AGENT_EXPLAIN_MODEL=gpt-4o-mini    # объяснение ответа
# AGENT_EXPLAIN_TEMPERATURE=0        # docs/LLM_CHOICE.md §4.2: T=0 -> меньше регенераций валидатора (было 0.2)
# AGENT_SIGNAL_MAX_AGE_H=12          # сигнал новостей старше N часов извлекается заново
# AGENT_PROMPT_VERSION=v4            # v1 | v2 | v3 | v4 — промпты роутера/объяснителя (docs/agent_prompt_ab.md); v1–v3 хранятся для A/B
# AGENT_CHECKPOINT_PATH=.cache/agent_checkpoints.sqlite   # SQLite-чекпоинты LangGraph (HITL resume между запусками CLI)

# --- MCP-сервер fpl-intelligence (fplcopilot.mcp_server, docs/mcp.md), необязательно ---
# stdio (по умолчанию) не требует настроек; host/port — только для --transport streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8765

# --- Vision (fplcopilot.vision, docs/vision.md): состав из скриншота Pick Team, необязательно ---
# VISION_MODEL=gpt-4o-mini           # мультимодальная модель (structured output, T=0)
# VISION_DETAIL=high                 # low | high | auto — detail изображения (high точнее, low дешевле)
# VISION_PROMPT_VERSION=v2           # v1 | v2 — версия промпта чтения скриншота (v1 хранится для A/B)

# --- FPL ---
# ID менеджера по умолчанию для CLI и smoke-скриптов (в UI не подставляется — см. APP_DEFAULT_MANAGER_ID)
FPL_MANAGER_ID=
# Кэш ответов FPL API на диске (сек). 0 — без кэша.
FPL_CACHE_TTL=3600

# --- Streamlit UI (fplcopilot.app, docs/ui.md): docker compose up -d -> http://localhost:${APP_PORT} ---
# APP_PORT=8501                      # порт UI на хосте (в контейнере всегда 8501)
# Предзаполнить поле «ID менеджера FPL» — только для локальной разработки / демо. На сервере для
# реальных пользователей оставьте пустым: каждый вводит свой ID, он живёт в адресе (?manager=<id>)
# и после «Сохранить» — в cookie браузера (fplc_manager).
# APP_DEFAULT_MANAGER_ID=

# --- Database (docker compose up -d db; pgvector/pgvector:pg16) ---
# Пусто = fpl / fpl / fpl, порт 5433 и DATABASE_URL postgresql://fpl:fpl@localhost:5433/fpl
# (дефолты docker-compose.yml и config.py совпадают). Свои POSTGRES_* -> свой DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# порт на хосте (в контейнере всегда 5432)
POSTGRES_PORT=
# postgresql://<user>:<password>@localhost:<port>/<db>
DATABASE_URL=

# --- News ingest (fplcopilot.rag.ingest), необязательно ---
# NEWS_FETCH_TIMEOUT=15
# NEWS_FETCH_DELAY=1
# NEWS_LIMIT_PER_SOURCE=200
# Окно сезона: статьи с published_at раньше этой даты не сохраняются (все источники)
# NEWS_BACKFILL_SINCE=2026-07-01
